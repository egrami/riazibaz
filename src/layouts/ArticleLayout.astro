
---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  cover?: string;
}

const { title, description, pubDate, category, cover } = Astro.props;

const base = import.meta.env.BASE_URL;
const formattedDate = new Intl.DateTimeFormat("fa-IR", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(pubDate);

const pageTitle = `${title} | ریاضی‌باز`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonical={Astro.url.pathname}
>
  <main class="article-page">
    <header class="site-header">
      <a class="brand" href={base}>
        <span class="brand-icon">∑</span>
        <span>ریاضی‌باز</span>
      </a>

      <nav>
        <a href={base}>صفحه اصلی</a>
        <a href={`${base}about/`}>درباره من</a>
        <a class="active" href={`${base}articles/`}>مقاله‌ها</a>
      </nav>

      <a class="header-cta" href={`${base}about/#contact-details`}>
        ارتباط با من ↗
      </a>
    </header>

    <article>
      <div class="article-heading">
        <a class="back-link" href={`${base}articles/`}>
          ← بازگشت به مقاله‌ها
        </a>

        <span class="category">{category}</span>

        <h1>{title}</h1>

        <p class="description">{description}</p>

        <div class="article-meta">
          <span>✦ ریاضی‌باز</span>
          <span>◷ {formattedDate}</span>
        </div>
      </div>

      {cover && (
        <div class="cover-wrapper">
          <img src={cover.startsWith("/") ? `${base}${cover.slice(1)}` : cover} alt={title} />
        </div>
      )}

      <div class="article-content">
        <slot />
      </div>

      <div class="article-end">
        <span>✦</span>
        <p>یادگیری ریاضی، یک ماجراجویی تازه!</p>
        <a href={`${base}articles/`}>مطالعه مقاله‌های دیگر ↗</a>
      </div>
    </article>

    <footer>
      <a class="brand" href={base}>
        <span class="brand-icon">∑</span>
        <span>ریاضی‌باز</span>
      </a>
      <span>© ریاضی‌باز</span>
    </footer>
  </main>
</BaseLayout>

<style>
  .article-page {
    min-height: 100vh;
    background:
      radial-gradient(ellipse at 50% 0%, #292d5540, transparent 45%);
  }

  .site-header {
    min-height: 78px;
    padding: 0 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #ffffff12;
    background: #10142cef;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 900;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: #10142c;
    background: #d8ff3e;
    font-size: 24px;
  }

  nav {
    display: flex;
    gap: 30px;
    color: #b9bdd3;
    font-size: 14px;
  }

  nav a:hover,
  nav a.active {
    color: #d8ff3e;
  }

  .header-cta {
    padding: 11px 18px;
    border-radius: 12px;
    background: #d8ff3e;
    color: #10142c;
    font-size: 13px;
    font-weight: 900;
  }

  article {
    width: min(850px, 88%);
    margin: 0 auto;
    padding: 65px 0 90px;
  }

  .article-heading {
    text-align: center;
  }

  .back-link {
    display: block;
    width: fit-content;
    margin: 0 auto 35px;
    color: #b9bdd3;
    font-size: 13px;
  }

  .back-link:hover {
    color: #d8ff3e;
  }

  .category {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid #d8ff3e55;
    border-radius: 30px;
    color: #d8ff3e;
    background: #d8ff3e10;
    font-size: 12px;
  }

  h1 {
    margin: 25px auto 15px;
    max-width: 760px;
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.8;
    font-weight: 900;
  }

  .description {
    max-width: 650px;
    margin: 0 auto;
    color: #b9bdd3;
    font-size: 15px;
    line-height: 2.2;
  }

  .article-meta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 25px;
    color: #9298b1;
    font-size: 12px;
  }

  .cover-wrapper {
    margin: 45px 0;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid #ffffff15;
    background: #191e3b;
  }

  .cover-wrapper img {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
  }

  .article-content {
    color: #e2e4ef;
    font-size: 16px;
    line-height: 2.5;
  }

  .article-content :global(h2) {
    margin: 45px 0 15px;
    color: #d8ff3e;
    font-size: 25px;
    line-height: 1.8;
  }

  .article-content :global(h3) {
    margin: 35px 0 12px;
    color: #5de2e7;
    font-size: 20px;
  }

  .article-content :global(p) {
    margin: 0 0 22px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-right: 25px;
    margin: 15px 0 25px;
  }

  .article-content :global(li) {
    margin-bottom: 10px;
  }

  .article-content :global(a) {
    color: #5de2e7;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .article-content :global(blockquote) {
    margin: 30px 0;
    padding: 20px 25px;
    border-right: 4px solid #a78bfa;
    border-radius: 12px;
    background: #a78bfa12;
    color: #d5c9ff;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: 30px auto;
    border-radius: 18px;
  }

  .article-end {
    margin-top: 70px;
    padding: 35px;
    border: 1px solid #ffffff15;
    border-radius: 22px;
    text-align: center;
    background: #191e3b;
  }

  .article-end > span {
    color: #d8ff3e;
    font-size: 30px;
  }

  .article-end p {
    color: #b9bdd3;
  }

  .article-end a {
    display: inline-block;
    margin-top: 10px;
    color: #d8ff3e;
    font-size: 13px;
    font-weight: 800;
  }

  footer {
    min-height: 90px;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #ffffff15;
    color: #9298b1;
    font-size: 12px;
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 15px 5%;
    }

    nav {
      display: none;
    }

    article {
      padding-top: 40px;
    }

    .cover-wrapper {
      margin: 30px 0;
      border-radius: 16px;
    }

    .article-content {
      font-size: 15px;
    }

    .article-end {
      padding: 25px 15px;
    }
  }
</style>
