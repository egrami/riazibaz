
---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title = "ریاضی‌باز | آموزش ریاضی با الهه گرامی",
  description = "آموزش مفهومی و جذاب ریاضی برای دانش‌آموزان پایه اول تا نهم.",
  canonical,
  noindex = false,
  image,
  imageAlt = "ریاضی‌باز | آموزش ریاضی",
  ogType = "website",
} = Astro.props;

const siteOrigin = "https://egrami.github.io";
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;

const fullTitle = title.includes("ریاضی‌باز")
  ? title
  : `${title} | ریاضی‌باز`;

// Resolve canonical URLs while preserving the GitHub Pages base path.
function resolvePageUrl(path: string): string {
  if (/^https?:\/\//i.test(path)) {
    return new URL(path).href;
  }

  const normalizedPath = path.startsWith("/")
    ? path
    : `/${path}`;

  if (
    normalizedPath === basePath.slice(0, -1) ||
    normalizedPath.startsWith(basePath)
  ) {
    return new URL(normalizedPath, siteOrigin).href;
  }

  return new URL(
    `${basePath}${normalizedPath.replace(/^\/+/, "")}`,
    siteOrigin
  ).href;
}

const pageUrl = resolvePageUrl(
  canonical ?? Astro.url.pathname
);

// Resolve image URLs without losing the site's base path.
function resolveImageUrl(path: string): string {
  if (/^https?:\/\//i.test(path)) {
    return new URL(path).href;
  }

  const normalizedPath = path.startsWith("/")
    ? path
    : `/${path}`;

  if (
    normalizedPath === basePath.slice(0, -1) ||
    normalizedPath.startsWith(basePath)
  ) {
    return new URL(normalizedPath, siteOrigin).href;
  }

  return new URL(
    `${basePath}${normalizedPath.replace(/^\/+/, "")}`,
    siteOrigin
  ).href;
}

const imageUrl = image ? resolveImageUrl(image) : undefined;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10142c" />

    <title>{fullTitle}</title>

    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    {noindex && (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="ریاضی‌باز" />

    {imageUrl && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:alt" content={imageAlt} />
      </>
    )}

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={imageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {imageUrl && (
      <>
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}

    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}favicon.svg`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <slot name="head" />
  </head>

  <body>
    <slot />

    <!-- Music Notice -->
    <section
      id="music-notice"
      class="music-notice"
      aria-label="اطلاع‌رسانی موسیقی پس‌زمینه"
    >
      <div class="music-notice-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M9 18V5L21 3V16"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle
            cx="6"
            cy="18"
            r="3"
            stroke="currentColor"
            stroke-width="1.8"
          />
          <circle
            cx="18"
            cy="16"
            r="3"
            stroke="currentColor"
            stroke-width="1.8"
          />
        </svg>
      </div>

      <div class="music-notice-content">
        <h2>قبل از شروع، یک سؤال کوچک! ✨</h2>

        <p>
          دوست داری هنگام گشت‌وگذار در ریاضی‌باز،
          موسیقی پس‌زمینه هم همراهت باشه؟
        </p>
      </div>

      <div class="music-notice-actions">
        <button
          id="music-notice-yes"
          class="music-notice-button music-notice-yes"
          type="button"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M9 18V5L21 3V16"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle
              cx="6"
              cy="18"
              r="3"
              stroke="currentColor"
              stroke-width="1.8"
            />
            <circle
              cx="18"
              cy="16"
              r="3"
              stroke="currentColor"
              stroke-width="1.8"
            />
          </svg>

          <span>بله، موسیقی پخش شود</span>
        </button>

        <button
          id="music-notice-no"
          class="music-notice-button music-notice-no"
          type="button"
        >
          نه، ممنون
        </button>
      </div>

      <span class="music-notice-decoration music-notice-decoration-one">✦</span>
      <span class="music-notice-decoration music-notice-decoration-two">✧</span>
    </section>

    <!-- Background Music Player -->
    <div
      class="music-widget"
      transition:persist="music-widget"
    >
      <audio
        id="site-background-audio"
        src={`${base}audio/background-music.mp3`}
        loop
        preload="auto"
        playsinline
      ></audio>

      <button
        id="music-toggle"
        class="music-toggle"
        type="button"
        aria-label="قطع صدای موسیقی"
        aria-pressed="false"
        title="قطع صدای موسیقی"
      >
        <svg
          class="music-icon"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M11 5L6 9H3V15H6L11 19V5Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <g class="sound-waves">
            <path
              d="M15.5 8.5C17.5 10.5 17.5 13.5 15.5 15.5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />

            <path
              d="M18.5 5.5C22 9 22 15 18.5 18.5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </g>

          <path
            class="mute-line"
            d="M16 9L21 15M21 9L16 15"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            style="display: none;"
          />
        </svg>
      </button>
    </div>

    <!-- Music Scripts -->
    <script>
      const appWindow = window as Window & {
        __riazibazMusicInitialized?: boolean;
        __riazibazNoticeDismissed?: boolean;
      };

      if (!appWindow.__riazibazMusicInitialized) {
        appWindow.__riazibazMusicInitialized = true;

        function getPlayer(): HTMLAudioElement | null {
          const element = document.getElementById(
            "site-background-audio"
          );

          return element instanceof HTMLAudioElement
            ? element
            : null;
        }

        function updateMusicButton() {
          const player = getPlayer();
          const button = document.getElementById("music-toggle");

          if (!player || !button) return;

          const isMuted = player.muted;

          button.setAttribute("aria-pressed", String(isMuted));

          button.setAttribute(
            "aria-label",
            isMuted
              ? "فعال کردن صدای موسیقی"
              : "قطع صدای موسیقی"
          );

          button.setAttribute(
            "title",
            isMuted
              ? "فعال کردن صدای موسیقی"
              : "قطع صدای موسیقی"
          );

          const soundWaves = button.querySelector(".sound-waves");
          const muteLine = button.querySelector(".mute-line");

          if (soundWaves instanceof SVGElement) {
            soundWaves.style.display = isMuted ? "none" : "block";
          }

          if (muteLine instanceof SVGElement) {
            muteLine.style.display = isMuted ? "block" : "none";
          }
        }

        function syncMusicNotice() {
          const notice = document.getElementById("music-notice");

          if (!notice) return;

          if (appWindow.__riazibazNoticeDismissed) {
            notice.classList.add("music-notice-hidden");
          }
        }

        // Initialize the player
        const initialPlayer = getPlayer();

        if (initialPlayer) {
          initialPlayer.volume = 0.05;
          initialPlayer.loop = true;
          initialPlayer.muted = false;
        }

        // Handle user choices
        document.addEventListener("click", (event) => {
          const target = event.target;

          if (!(target instanceof Element)) return;

          // User chooses YES
          const yesButton = target.closest("#music-notice-yes");

          if (yesButton) {
            event.preventDefault();

            const player = getPlayer();

            appWindow.__riazibazNoticeDismissed = true;

            syncMusicNotice();

            if (player) {
              player.volume = 0.05;
              player.muted = false;

              player.play()
                .then(() => {
                  updateMusicButton();
                })
                .catch((error: unknown) => {
                  console.warn(
                    "Background music could not start:",
                    error
                  );
                });
            }

            updateMusicButton();

            return;
          }

          // User chooses NO
          const noButton = target.closest("#music-notice-no");

          if (noButton) {
            event.preventDefault();

            appWindow.__riazibazNoticeDismissed = true;

            // Close the notice without starting music.
            syncMusicNotice();

            return;
          }

          // Mute / Unmute
          const musicButton = target.closest("#music-toggle");

          if (musicButton) {
            event.preventDefault();

            const player = getPlayer();

            if (!player) return;

            player.muted = !player.muted;

            updateMusicButton();
          }
        });

        // Keep the notice hidden during Astro navigation.
        document.addEventListener("astro:after-swap", syncMusicNotice);

        document.addEventListener("astro:page-load", () => {
          syncMusicNotice();
          updateMusicButton();
        });

        syncMusicNotice();
        updateMusicButton();
      }
    </script>

    <style is:global>
      :root {
        font-family: "Vazirmatn", Tahoma, sans-serif;
        color-scheme: dark;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        --color-background: #10142c;
        --color-surface: #191e3b;
        --color-primary: #d8ff3e;
        --color-secondary: #ff715b;
        --color-purple: #a78bfa;
        --color-cyan: #5de2e7;
        --color-text: #ffffff;
        --color-muted: #b9bdd3;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--color-background);
      }

      body {
        margin: 0;
        min-width: 320px;
        min-height: 100vh;
        background: var(--color-background);
        color: var(--color-text);
        direction: rtl;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        cursor: pointer;
      }

      img {
        display: block;
        max-width: 100%;
      }

      ::selection {
        color: #10142c;
        background: var(--color-primary);
      }

      :focus-visible {
        outline: 3px solid var(--color-primary);
        outline-offset: 4px;
      }

      /* Music Notice */

      .music-notice {
        position: fixed;
        top: 22px;
        left: 50%;
        z-index: 10000;

        width: min(560px, calc(100% - 32px));

        display: grid;
        grid-template-columns: 54px 1fr;
        align-items: center;
        gap: 15px;

        padding: 22px;

        overflow: hidden;

        border: 1px solid #a78bfa44;
        border-radius: 22px;

        background:
          radial-gradient(
            circle at 100% 0%,
            #a78bfa20,
            transparent 45%
          ),
          linear-gradient(145deg, #202748, #171d3b);

        box-shadow:
          0 18px 60px #00000066,
          0 0 0 1px #ffffff08;

        opacity: 1;
        visibility: visible;
        transform: translateX(-50%);

        transition:
          opacity 0.35s ease,
          transform 0.35s ease,
          visibility 0.35s ease;
      }

      .music-notice-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translate(-50%, -18px);
      }

      .music-notice-icon {
        width: 54px;
        height: 54px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #d8ff3e55;
        border-radius: 17px;

        background: #d8ff3e15;
        color: var(--color-primary);
      }

      .music-notice-icon svg {
        width: 27px;
        height: 27px;
      }

      .music-notice-content {
        position: relative;
        z-index: 1;
      }

      .music-notice-content h2 {
        margin: 0 0 7px;
        color: #ffffff;
        font-size: 16px;
        font-weight: 900;
      }

      .music-notice-content p {
        margin: 0;
        color: var(--color-muted);
        font-size: 12px;
        line-height: 2;
      }

      .music-notice-actions {
        position: relative;
        z-index: 1;

        grid-column: 1 / -1;

        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
      }

      .music-notice-button {
        min-height: 46px;

        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;

        padding: 10px 16px;

        border-radius: 13px;

        font-size: 13px;
        font-weight: 800;

        transition:
          transform 0.2s ease,
          background 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
      }

      .music-notice-button:hover {
        transform: translateY(-2px);
      }

      .music-notice-yes {
        border: 0;
        background: var(--color-primary);
        color: #10142c;
        box-shadow: 0 6px 22px #d8ff3e22;
      }

      .music-notice-yes:hover {
        background: #e5ff75;
        box-shadow: 0 9px 26px #d8ff3e35;
      }

      .music-notice-yes svg {
        width: 19px;
        height: 19px;
        flex-shrink: 0;
      }

      .music-notice-no {
        border: 1px solid #ffffff30;
        background: #ffffff08;
        color: #d4d8e9;
        white-space: nowrap;
      }

      .music-notice-no:hover {
        border-color: #ffffff65;
        background: #ffffff12;
        color: #ffffff;
      }

      .music-notice-decoration {
        position: absolute;
        pointer-events: none;
        color: #a78bfa66;
      }

      .music-notice-decoration-one {
        top: 12px;
        left: 17px;
        font-size: 20px;
      }

      .music-notice-decoration-two {
        bottom: 68px;
        left: 35px;
        color: #d8ff3e66;
        font-size: 25px;
      }

      /* Floating Music Button */

      .music-widget {
        position: fixed;
        left: max(22px, env(safe-area-inset-left));
        bottom: max(22px, env(safe-area-inset-bottom));
        z-index: 9999;
        pointer-events: none;
      }

      .music-toggle {
        width: 52px;
        height: 52px;
        padding: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #d8ff3e55;
        border-radius: 50%;

        background: #191e3b;
        color: var(--color-primary);

        box-shadow: 0 5px 22px #00000045;

        cursor: pointer;
        pointer-events: auto;

        transition:
          transform 0.25s ease,
          background 0.25s ease,
          box-shadow 0.25s ease;
      }

      .music-toggle:hover {
        transform: translateY(-3px);
        background: #252d50;
        box-shadow: 0 8px 25px #00000055;
      }

      .music-icon {
        width: 23px;
        height: 23px;
      }

      .music-toggle:focus-visible {
        outline: 3px solid var(--color-primary);
        outline-offset: 4px;
      }

      @media (max-width: 600px) {
        .music-notice {
          top: 12px;
          width: calc(100% - 24px);
          grid-template-columns: 46px 1fr;
          gap: 12px;
          padding: 17px;
          border-radius: 18px;
        }

        .music-notice-icon {
          width: 46px;
          height: 46px;
          border-radius: 14px;
        }

        .music-notice-content h2 {
          font-size: 14px;
        }

        .music-notice-content p {
          font-size: 11px;
        }

        .music-notice-actions {
          grid-template-columns: 1fr 0.65fr;
          gap: 8px;
        }

        .music-notice-button {
          min-height: 44px;
          padding: 9px 10px;
          font-size: 11px;
        }

        .music-notice-yes {
          gap: 6px;
        }

        .music-notice-yes svg {
          width: 17px;
          height: 17px;
        }

        .music-widget {
          left: max(16px, env(safe-area-inset-left));
          bottom: max(16px, env(safe-area-inset-bottom));
        }

        .music-toggle {
          width: 48px;
          height: 48px;
        }
      }

      @media (max-width: 360px) {
        .music-notice {
          padding: 14px;
        }

        .music-notice-content h2 {
          font-size: 13px;
        }

        .music-notice-content p {
          font-size: 10px;
        }

        .music-notice-button {
          font-size: 10px;
          padding: 8px 6px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
