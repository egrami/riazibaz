
---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = "ریاضی‌باز | آموزش ریاضی با الهه گرامی",
  description = "آموزش مفهومی و جذاب ریاضی برای دانش‌آموزان پایه اول تا نهم.",
  canonical,
  noindex = false,
} = Astro.props;

const siteUrl = "https://egrami.github.io/riazibaz";

const pageUrl = canonical
  ? new URL(canonical, siteUrl + "/").href
  : Astro.url.href;

const fullTitle = title.includes("ریاضی‌باز")
  ? title
  : `${title} | ریاضی‌باز`;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#10142c" />

    <title>{fullTitle}</title>

    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    {noindex && (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="ریاضی‌باز" />

    <link
      rel="icon"
      type="image/svg+xml"
      href={`${base}favicon.svg`}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <slot name="head" />
  </head>

  <body>
    <slot />

    <!-- Background Music Player -->
    <div
      class="music-widget"
      transition:persist="music-widget"
    >
      <audio
        id="site-background-audio"
        src={`${base}audio/background-music.mp3`}
        autoplay
        loop
        preload="auto"
        playsinline
      ></audio>

      <button
        id="music-toggle"
        class="music-toggle"
        type="button"
        aria-label="قطع صدای موسیقی"
        aria-pressed="false"
        title="قطع صدای موسیقی"
      >
        <svg
          class="music-icon"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M11 5L6 9H3V15H6L11 19V5Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <g class="sound-waves">
            <path
              d="M15.5 8.5C17.5 10.5 17.5 13.5 15.5 15.5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />

            <path
              d="M18.5 5.5C22 9 22 15 18.5 18.5"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </g>

          <path
            class="mute-line"
            d="M16 9L21 15M21 9L16 15"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            style="display: none;"
          />
        </svg>
      </button>
    </div>

    <!-- Music Player Script -->
    <script>
      const audio = document.getElementById(
        "site-background-audio"
      ) as HTMLAudioElement | null;

      const musicButton = document.getElementById("music-toggle");

      if (audio && musicButton) {
        const player = audio;
        const button = musicButton;

        // Default music settings
        player.volume = 0.3;
        player.loop = true;
        player.muted = false;

        // Update mute button appearance
        function updateMusicButton() {
          const isMuted = player.muted;

          button.setAttribute(
            "aria-pressed",
            String(isMuted)
          );

          button.setAttribute(
            "aria-label",
            isMuted
              ? "فعال کردن صدای موسیقی"
              : "قطع صدای موسیقی"
          );

          button.setAttribute(
            "title",
            isMuted
              ? "فعال کردن صدای موسیقی"
              : "قطع صدای موسیقی"
          );

          const soundWaves = button.querySelector(
            ".sound-waves"
          );

          const muteLine = button.querySelector(
            ".mute-line"
          );

          if (soundWaves instanceof SVGElement) {
            soundWaves.style.display = isMuted
              ? "none"
              : "block";
          }

          if (muteLine instanceof SVGElement) {
            muteLine.style.display = isMuted
              ? "block"
              : "none";
          }
        }

        // Remove autoplay retry listeners after playback starts
        function removeInteractionListeners() {
          document.removeEventListener(
            "pointerdown",
            startAfterInteraction,
            true
          );

          document.removeEventListener(
            "keydown",
            startAfterInteraction,
            true
          );
        }

        // Retry playback after the first user interaction
        function startAfterInteraction() {
          player.play()
            .then(() => {
              removeInteractionListeners();
            })
            .catch(() => {
              // Wait for another user interaction.
            });
        }

        // Initial autoplay attempt
        function startMusic() {
          player.play()
            .then(() => {
              removeInteractionListeners();
            })
            .catch(() => {
              // The browser may block autoplay.
              // Playback will be retried after user interaction.
            });
        }

        // Mute / Unmute button
        button.addEventListener("click", () => {
          player.muted = !player.muted;

          if (player.paused) {
            startMusic();
          }

          updateMusicButton();
        });

        // Listen for the first user interaction
        document.addEventListener(
          "pointerdown",
          startAfterInteraction,
          true
        );

        document.addEventListener(
          "keydown",
          startAfterInteraction,
          true
        );

        // Keep button appearance synchronized after navigation
        document.addEventListener(
          "astro:page-load",
          updateMusicButton
        );

        updateMusicButton();

        // Try to start music immediately
        startMusic();
      }
    </script>

    <style is:global>
      :root {
        font-family: "Vazirmatn", Tahoma, sans-serif;
        color-scheme: dark;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        --color-background: #10142c;
        --color-surface: #191e3b;
        --color-primary: #d8ff3e;
        --color-secondary: #ff715b;
        --color-purple: #a78bfa;
        --color-cyan: #5de2e7;
        --color-text: #ffffff;
        --color-muted: #b9bdd3;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--color-background);
      }

      body {
        margin: 0;
        min-width: 320px;
        min-height: 100vh;
        background: var(--color-background);
        color: var(--color-text);
        direction: rtl;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        cursor: pointer;
      }

      img {
        display: block;
        max-width: 100%;
      }

      ::selection {
        color: #10142c;
        background: var(--color-primary);
      }

      :focus-visible {
        outline: 3px solid var(--color-primary);
        outline-offset: 4px;
      }

      /* Floating Music Button */

      .music-widget {
        position: fixed;
        left: max(22px, env(safe-area-inset-left));
        bottom: max(22px, env(safe-area-inset-bottom));
        z-index: 9999;
        pointer-events: none;
      }

      .music-toggle {
        width: 52px;
        height: 52px;
        padding: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #d8ff3e55;
        border-radius: 50%;

        background: #191e3b;
        color: var(--color-primary);

        box-shadow: 0 5px 22px #00000045;

        cursor: pointer;
        pointer-events: auto;

        transition:
          transform 0.25s ease,
          background 0.25s ease,
          box-shadow 0.25s ease;
      }

      .music-toggle:hover {
        transform: translateY(-3px);
        background: #252d50;
        box-shadow: 0 8px 25px #00000055;
      }

      .music-icon {
        width: 23px;
        height: 23px;
      }

      .music-toggle:focus-visible {
        outline: 3px solid var(--color-primary);
        outline-offset: 4px;
      }

      @media (max-width: 600px) {
        .music-widget {
          left: max(16px, env(safe-area-inset-left));
          bottom: max(16px, env(safe-area-inset-bottom));
        }

        .music-toggle {
          width: 48px;
          height: 48px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
</html>
