
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const grades = [
  { number: "۰۱ تا ۰۳", title: "پایه‌های اول تا سوم", text: "شروع یک ماجراجویی شیرین با دنیای اعداد", color: "lime", icon: "✳" },
  { number: "۰۴ تا ۰۶", title: "پایه‌های چهارم تا ششم", text: "کشف الگوها و ساختن پایه‌ای محکم", color: "coral", icon: "✦" },
  { number: "۰۷ تا ۰۹", title: "پایه‌های هفتم تا نهم", text: "ورود به دنیای مفاهیم و چالش‌های تازه", color: "purple", icon: "∑" },
];

const methods = [
  { icon: "🧩", title: "یادگیری مفهومی", text: "به‌جای حفظ کردن فرمول‌ها، دلیل و منطق پشت هر مسئله رو یاد می‌گیریم." },
  { icon: "🚀", title: "قدم‌به‌قدم", text: "هر موضوع رو متناسب با سطح دانش‌آموز پیش می‌بریم تا هیچ مرحله‌ای مبهم نمونه." },
  { icon: "🎯", title: "متناسب با هر دانش‌آموز", text: "روش آموزش رو با نیازها، توانایی‌ها و سرعت یادگیری هر دانش‌آموز هماهنگ می‌کنیم." },
];

const articles = (await getCollection("articles"))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  )
  .slice(0, 3)
  .map((article, index) => ({
    category: article.data.category,
    title: article.data.title,
    slug: article.id,
    color: ["article-one", "article-two", "article-three"][index % 3],
    symbol: ["＋", "÷", "×"][index % 3],
  }));
---

<BaseLayout
  title="ریاضی‌باز | ماجراجویی در دنیای ریاضی"
  description="با آموزش مفهومی و خلاقانه ریاضی، یادگیری را به یک ماجراجویی هیجان‌انگیز تبدیل کنیم."
>
  <div class="site-shell">
    <header class="header">
      <a href={base} class="brand" aria-label="صفحه اصلی ریاضی‌باز">
        <span class="brand-symbol">∑</span>
        <span>ریاضی‌باز<span class="brand-dot">.</span></span>
      </a>

      <nav class="navigation">
        <a href={base} class="nav-link active">خانه</a>
        <a href={`${base}about/`} class="nav-link">درباره الهه</a>
        <a href="#grades" class="nav-link">کلاس‌ها</a>
        <a href="#articles" class="nav-link">مجله ریاضی</a>
      </nav>

      <a href="#contact" class="header-cta">
        شروع ماجراجویی <span>↖</span>
      </a>

      <button class="menu-toggle" aria-label="باز کردن منو" aria-expanded="false">
        <span></span><span></span>
      </button>
    </header>

    <main>
      <section class="hero">
        <div class="hero-stars"></div>
        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>

        <div class="hero-copy">
          <div class="eyebrow">
            <span class="eyebrow-star">✦</span>
            دنیای ریاضی، فراتر از تصور تو!
          </div>

          <h1>
            ریاضی فقط<br />
            <span class="outline-text">عدد و فرمول</span> نیست؛
            <span class="highlight-text">ماجراجوییه!</span>
          </h1>

          <p class="hero-description">
            آماده‌ای به دنیایی سفر کنی که توش هر مسئله یک معماست و هر جواب، یک کشف تازه؟
            بیا ریاضی رو جور دیگه‌ای تجربه کنیم.
          </p>

          <div class="hero-actions">
            <a href="#grades" class="primary-button">بزن بریم! <span>←</span></a>
            <a href={`${base}about/`} class="secondary-button">با معلمت آشنا شو</a>
          </div>

          <div class="hero-note">
            <span class="note-icon">✳</span>
            <span>از پایه اول تا نهم، همراه قدم‌به‌قدم تو</span>
          </div>
        </div>

        <div class="hero-art" aria-label="تصویرسازی فضایی ریاضی‌باز">
          <div class="planet-ring"></div>
          <div class="planet">
            <div class="planet-land land-one"></div>
            <div class="planet-land land-two"></div>
            <div class="planet-land land-three"></div>
            <div class="planet-shine"></div>
          </div>

          <div class="moon"></div>
          <div class="floating-symbol symbol-plus">＋</div>
          <div class="floating-symbol symbol-pi">π</div>
          <div class="floating-symbol symbol-root">√</div>
          <div class="floating-star star-a">✦</div>
          <div class="floating-star star-b">✧</div>
          <div class="floating-star star-c">✦</div>

          <div class="rocket">
            <div class="rocket-fin fin-left"></div>
            <div class="rocket-fin fin-right"></div>
            <div class="rocket-body">
              <div class="rocket-window"></div>
              <div class="rocket-line"></div>
            </div>
            <div class="rocket-flame"></div>
          </div>

          <div class="art-label">
            <span class="label-dot"></span>
            MATH EXPLORER
          </div>
        </div>

        <div class="hero-bottom">
          <span>01 / 04</span>
          <span class="hero-bottom-line"></span>
          <span>LET'S EXPLORE MATH</span>
        </div>
      </section>

      <section class="grades-section section-pad" id="grades">
        <div class="section-heading">
          <div>
            <span class="section-kicker">YOUR NEXT MISSION</span>
            <h2>ماجراجویی از کدوم <span>پایه؟</span></h2>
          </div>
          <p>هر سنی، یک مرحله تازه از این سفره. مسیر یادگیریت رو انتخاب کن!</p>
        </div>

        <div class="grade-grid">
          {grades.map((grade, index) => (
            <article class={`grade-card ${grade.color}`}>
              <div class="grade-top">
                <span class="grade-number">{grade.number}</span>
                <span class="grade-icon">{grade.icon}</span>
              </div>
              <div class="grade-bottom">
                <span class="grade-index">MISSION 0{index + 1}</span>
                <h3>{grade.title}</h3>
                <p>{grade.text}</p>
                <span class="grade-arrow">↙</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="method-section section-pad" id="method">
        <div class="method-intro">
          <span class="section-kicker">HOW WE LEARN</span>
          <h2>اینجا قرار نیست فقط<br /><span>جواب‌ها رو حفظ کنیم!</span></h2>
          <p>
            یادگیری واقعی وقتی اتفاق می‌افته که بفهمیم چرا و چطور.
            برای همین، در ریاضی‌باز مسیر یادگیری از درک مفاهیم شروع می‌شه.
          </p>
          <a href={`${base}about/`} class="text-link">بیشتر درباره روش تدریس <span>←</span></a>
        </div>

        <div class="method-list">
          {methods.map((method, index) => (
            <article class="method-item">
              <span class="method-index">0{index + 1}</span>
              <span class="method-icon">{method.icon}</span>
              <div>
                <h3>{method.title}</h3>
                <p>{method.text}</p>
              </div>
              <span class="method-arrow">↙</span>
            </article>
          ))}
        </div>
      </section>

      <section class="teacher-section section-pad">
        <div class="teacher-visual">
          <div class="teacher-circle">
            <span class="teacher-equation">x² + y²</span>
            <span class="teacher-spark">✦</span>
            <span class="teacher-big-symbol">∑</span>
            <span class="teacher-small-symbol">π</span>
          </div>
          <div class="teacher-caption">MEET YOUR MATH GUIDE</div>
        </div>

        <div class="teacher-copy">
          <span class="section-kicker">THE PERSON BEHIND THE MISSION</span>
          <h2>سلام! من <span>الهه</span> هستم.</h2>
          <p>
            فارغ‌التحصیل رشته ریاضی کاربردی و همراه شما در مسیر یادگیری ریاضی.
            باور دارم هر دانش‌آموز می‌تونه ریاضی رو بفهمه؛ فقط باید راه درست یادگیری خودش رو پیدا کنه.
          </p>
          <div class="teacher-tags">
            <span>ریاضی کاربردی</span>
            <span>سابقه تدریس</span>
            <span>المپیاد ریاضی</span>
          </div>
          <a href={`${base}about/`} class="primary-button teacher-button">بیشتر با من آشنا شو <span>←</span></a>
        </div>
      </section>

      <section class="articles-section section-pad" id="articles">
        <div class="section-heading">
          <div>
            <span class="section-kicker">MATH MAGAZINE</span>
            <h2>ایستگاه <span>دانستنی‌ها</span></h2>
          </div>
          <p>اینجا کلی ایده و راهکار برای یادگیری بهتر ریاضی پیدا می‌کنی.</p>
        </div>

        {articles.length > 0 ? (
          <div class="article-grid">
            {articles.map((article, index) => (
              <a href={`${base}articles/${article.slug}/`} class="article-card">
                <div class={`article-cover ${article.color}`}>
                  <span class="article-symbol">{article.symbol}</span>
                  <span class="article-cover-index">ARTICLE / 0{index + 1}</span>
                  <span class="article-cover-star">✦</span>
                </div>
                <div class="article-info">
                  <span class="article-category">{article.category}</span>
                  <h3>{article.title}</h3>
                  <span class="article-read">مطالعه مقاله <span>←</span></span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="articles-empty">به‌زودی مقاله‌های جدید منتشر می‌شوند!</p>
        )}

        <a href={`${base}articles/`} class="articles-archive-link">
          مشاهده همه مقاله‌ها <span>←</span>
        </a>
      </section>

      <section class="contact-section section-pad" id="contact">
        <div class="contact-orb orb-left"></div>
        <div class="contact-orb orb-right"></div>
        <span class="section-kicker">READY FOR TAKEOFF?</span>
        <h2>سفر ریاضی تو<br /><span>از همین‌جا شروع می‌شه!</span></h2>
        <p>برای آشنایی بیشتر با کلاس‌ها و هماهنگی جلسات، با ما در ارتباط باش.</p>
        <a href={`${base}about/#contact-details`} class="contact-button">بیا با هم صحبت کنیم <span>↖</span></a>
        <span class="contact-decoration">∞</span>
      </section>
    </main>

    <footer class="footer">
      <a href={base} class="brand footer-brand">
        <span class="brand-symbol">∑</span>
        <span>ریاضی‌باز<span class="brand-dot">.</span></span>
      </a>
      <p>یادگیری ریاضی، یک ماجراجویی بی‌پایان است.</p>
      <span class="footer-copy">© ریاضی‌باز</span>
    </footer>
  </div>

  <script>
    const menuButton = document.querySelector(".menu-toggle");
    const navigation = document.querySelector(".navigation");

    menuButton?.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!isOpen));
      navigation?.classList.toggle("nav-open", !isOpen);
    });

    navigation?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        navigation.classList.remove("nav-open");
        menuButton?.setAttribute("aria-expanded", "false");
      });
    });
  </script>

  <style>
    .site-shell { overflow: hidden; background: #10142c; }
    .header {
      height: 82px; max-width: 1440px; margin: auto; padding: 0 6%;
      display: flex; align-items: center; justify-content: space-between;
      position: relative; z-index: 20; background: #10142c;
    }
    .brand { display: flex; align-items: center; gap: 10px; font-size: 23px; font-weight: 900; }
    .brand-symbol { width: 39px; height: 39px; display: grid; place-items: center; border-radius: 12px; background: #d8ff3e; color: #10142c; font-size: 24px; }
    .brand-dot { color: #d8ff3e; }
    .navigation { display: flex; gap: 36px; align-items: center; }
    .nav-link { color: #aeb3cb; font-size: 13px; transition: .2s; }
    .nav-link:hover, .nav-link.active { color: #d8ff3e; }
    .header-cta { padding: 12px 19px; border: 1px solid #454b68; border-radius: 9px; font-size: 12px; font-weight: 700; }
    .header-cta span { color: #d8ff3e; margin-right: 8px; }
    .menu-toggle { display: none; }

    .hero {
      min-height: 610px; max-width: 1440px; margin: auto; padding: 75px 8% 55px;
      position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: center;
      background: radial-gradient(ellipse at 75% 45%, #252b50 0%, #171c3a 37%, #10142c 76%);
    }
    .hero-stars {
      position: absolute; inset: 0; pointer-events: none; opacity: .6;
      background-image: radial-gradient(#fff 1px, transparent 1px), radial-gradient(#8a92c2 1px, transparent 1px);
      background-size: 83px 83px, 127px 127px; background-position: 0 0, 30px 42px;
    }
    .hero-copy { position: relative; z-index: 3; max-width: 560px; }
    .eyebrow { display: inline-flex; align-items: center; gap: 9px; padding: 9px 14px; border: 1px solid #414767; border-radius: 50px; color: #dce1f5; font-size: 12px; }
    .eyebrow-star { color: #d8ff3e; }
    .hero h1 { font-size: clamp(38px, 5vw, 66px); line-height: 1.55; font-weight: 900; margin: 24px 0 15px; letter-spacing: -2px; }
    .outline-text { color: transparent; -webkit-text-stroke: 1.5px #d8ff3e; }
    .highlight-text { color: #d8ff3e; display: inline-block; }
    .hero-description { color: #b8bfd8; line-height: 2.3; font-size: 14px; max-width: 490px; }
    .hero-actions { display: flex; align-items: center; gap: 14px; margin-top: 30px; }
    .primary-button { display: inline-flex; align-items: center; gap: 20px; padding: 15px 23px; border-radius: 9px; background: #d8ff3e; color: #11152b; font-weight: 900; font-size: 13px; transition: transform .25s, box-shadow .25s; }
    .primary-button:hover { transform: translateY(-4px); box-shadow: 0 10px 35px #d8ff3e33; }
    .secondary-button { padding: 14px 19px; color: #e4e7f6; border: 1px solid #454b68; border-radius: 9px; font-size: 12px; }
    .hero-note { display: flex; align-items: center; gap: 10px; margin-top: 35px; color: #9299b7; font-size: 11px; }
    .note-icon { color: #ff715b; font-size: 20px; }

    .hero-art { height: 440px; position: relative; z-index: 2; }
    .planet-ring { position: absolute; width: 370px; height: 370px; border: 1px solid #747ca4; border-radius: 50%; top: 30px; left: 50%; transform: translateX(-50%) rotate(-23deg) scaleY(.43); opacity: .65; }
    .planet {
      position: absolute; width: 275px; height: 275px; border-radius: 50%; top: 70px; left: 50%; transform: translateX(-50%);
      overflow: hidden; background: radial-gradient(circle at 30% 23%, #7de5e8 0%, #4e91c6 30%, #34539a 67%, #18234e 100%);
      box-shadow: inset -30px -22px 45px #0b133b, 0 0 70px #6687ef33;
    }
    .planet-land { position: absolute; background: #83c77d; opacity: .85; filter: drop-shadow(0 3px 2px #174b64); }
    .land-one { width: 90px; height: 75px; top: 48px; left: 45px; border-radius: 63% 37% 42% 58% / 37% 45% 55% 63%; transform: rotate(-22deg); }
    .land-two { width: 68px; height: 100px; top: 120px; left: 145px; border-radius: 45% 55% 60% 40%; transform: rotate(25deg); }
    .land-three { width: 40px; height: 33px; top: 30px; right: 30px; border-radius: 60%; }
    .planet-shine { position: absolute; inset: 0; border-radius: 50%; background: linear-gradient(115deg, #ffffff40, transparent 38%); }
    .moon { position: absolute; top: 38px; right: 50px; width: 48px; height: 48px; background: #f2d99c; border-radius: 50%; box-shadow: 0 0 30px #f2d99c66; }
    .floating-symbol { position: absolute; z-index: 3; font-weight: 900; animation: float 5s ease-in-out infinite; }
    .symbol-plus { top: 72px; left: 55px; font-size: 42px; color: #d8ff3e; }
    .symbol-pi { bottom: 100px; right: 30px; font-size: 36px; color: #ff715b; animation-delay: -2s; }
    .symbol-root { top: 230px; left: 22px; font-size: 38px; color: #b59cff; animation-delay: -1s; }
    .floating-star { position: absolute; color: #fff; }
    .star-a { top: 20px; left: 45%; font-size: 22px; }
    .star-b { bottom: 30px; left: 37%; color: #d8ff3e; font-size: 30px; }
    .star-c { top: 155px; right: 15px; color: #ff715b; font-size: 20px; }
    .rocket { position: absolute; width: 90px; height: 160px; left: 65%; top: 160px; z-index: 4; transform: rotate(35deg); animation: rocketFloat 5s ease-in-out infinite; }
    .rocket-body { position: absolute; width: 61px; height: 115px; top: 0; left: 15px; background: linear-gradient(90deg, #cbd5ef, #fff 48%, #9ca9d1); border-radius: 55% 55% 25% 25%; border: 2px solid #8795bd; }
    .rocket-body:before { content: ""; position: absolute; top: -3px; left: 17px; width: 23px; height: 22px; background: #ff715b; border-radius: 50% 50% 5px 5px; }
    .rocket-window { position: absolute; width: 27px; height: 27px; top: 37px; left: 15px; border: 5px solid #d8ff3e; border-radius: 50%; background: #386d9e; }
    .rocket-line { position: absolute; width: 100%; height: 5px; background: #ff715b; top: 83px; }
    .rocket-fin { position: absolute; bottom: 24px; width: 28px; height: 48px; background: #ff715b; z-index: -1; }
    .fin-left { left: 0; border-radius: 100% 0 0 10%; transform: skewY(22deg); }
    .fin-right { right: 0; border-radius: 0 100% 10% 0; transform: skewY(-22deg); }
    .rocket-flame { position: absolute; width: 23px; height: 57px; left: 34px; bottom: -49px; background: linear-gradient(#d8ff3e, #ff715b, transparent); border-radius: 50%; filter: blur(2px); }
    .art-label { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); color: #9da5c6; font-size: 9px; letter-spacing: 4px; white-space: nowrap; }
    .label-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #d8ff3e; margin-left: 8px; }
    .hero-bottom { position: absolute; bottom: 20px; left: 8%; right: 8%; display: flex; align-items: center; gap: 15px; color: #737b9c; font-size: 9px; letter-spacing: 2px; }
    .hero-bottom-line { height: 1px; width: 65px; background: #d8ff3e; }

    .section-pad { padding: 100px max(8%, calc((100% - 1200px) / 2)); }
    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
    .section-kicker { color: #d8ff3e; font-size: 10px; letter-spacing: 3px; font-weight: 800; }
    .section-heading h2, .method-intro h2, .teacher-copy h2 { font-size: clamp(27px, 3.3vw, 42px); line-height: 1.7; margin: 10px 0 0; font-weight: 900; }
    .section-heading h2 span, .method-intro h2 span, .teacher-copy h2 span { color: #d8ff3e; }
    .section-heading > p { color: #9da4c0; font-size: 12px; line-height: 2.2; max-width: 340px; margin: 0 0 7px; }

    .grades-section { background: #141932; }
    .grade-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .grade-card { min-height: 250px; padding: 25px; border-radius: 15px; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; transition: transform .25s; }
    .grade-card:hover { transform: translateY(-8px); }
    .grade-card.lime { background: #d8ff3e; color: #151a30; }
    .grade-card.coral { background: #ff715b; color: #25182a; }
    .grade-card.purple { background: #a78bfa; color: #191632; }
    .grade-top { display: flex; justify-content: space-between; align-items: center; }
    .grade-number { font-size: 11px; font-weight: 800; letter-spacing: 2px; }
    .grade-icon { font-size: 40px; }
    .grade-index { font-size: 9px; letter-spacing: 2px; opacity: .65; font-weight: 800; }
    .grade-bottom h3 { font-size: 21px; margin: 8px 0; font-weight: 900; }
    .grade-bottom p { font-size: 11px; opacity: .75; line-height: 2; margin: 0; }
    .grade-arrow { position: absolute; left: 22px; bottom: 18px; font-size: 25px; }

    .method-section { display: grid; grid-template-columns: .9fr 1.1fr; gap: 75px; align-items: center; }
    .method-intro h2 { margin: 15px 0; }
    .method-intro > p, .teacher-copy > p { color: #aeb4cd; font-size: 13px; line-height: 2.5; }
    .text-link { display: inline-flex; gap: 14px; align-items: center; color: #d8ff3e; font-size: 12px; font-weight: 800; margin-top: 20px; }
    .method-list { border-top: 1px solid #343b5a; }
    .method-item { display: grid; grid-template-columns: 35px 52px 1fr 20px; gap: 14px; align-items: center; padding: 25px 0; border-bottom: 1px solid #343b5a; }
    .method-index { color: #737b9c; font-size: 11px; }
    .method-icon { width: 48px; height: 48px; border-radius: 13px; display: grid; place-items: center; background: #252b4a; font-size: 23px; }
    .method-item h3 { font-size: 15px; margin: 0 0 7px; }
    .method-item p { color: #9da4c0; font-size: 11px; line-height: 2; margin: 0; }
    .method-arrow { color: #d8ff3e; font-size: 19px; }

